tellraw @s ["\n", {"text":"VanillaPlusCore • Ajuda: Livros de Estatísticas\n", "color":"gold", "bold": true}, {"text":"Como criar um livro de estatísticas (Atril):"}, "\n    1. Escolha um objetivo (ex: enriched.custom.jump, enriched.custom.walk_one_cm).", "\n    2. Escreva o nome exato na página 1 de um Livro e Pena.", "\n    3. Assine o livro com o título \"MCStats\".", "\n    4. Coloque o livro em um Atril para ativá-lo imediatamente.\n"]

execute if score refreshType enriched.settings matches 1 run tellraw @s ["", {"text": "Atualização de Livros\n", "color":"yellow", "bold": true}, "Fique em cima do atril e use ", {"text": "/trigger enriched.update", "underlined": true, "click_event": {"action": "suggest_command", "command": "/trigger enriched.update"}}, " para atualizar este livro."]
execute if score refreshType enriched.settings matches 2 run tellraw @s ["", {"text": "Atualização de Livros\n", "color":"yellow", "bold": true}, "Fique a até 16 blocos do atril e use ", {"text": "/trigger enriched.update", "underlined": true, "click_event": {"action": "suggest_command", "command": "/trigger enriched.update"}}, " para atualizar os livros da área."]
execute if score refreshType enriched.settings matches 3 run tellraw @s ["", {"text": "Atualização de Livros\n", "color":"yellow", "bold": true}, "Todos os atrís carregados são atualizados a cada 5 minutos automaticamente."]
execute if score refreshType enriched.settings matches 4 run tellraw @s ["", {"text": "Atualização de Livros\n", "color":"yellow", "bold": true}, "Livros são atualizados apenas manualmente por administradores."]
execute if score autoOptIn enriched.settings matches 0 run tellraw @s ["", {"text": "Participação (Opt-in)\n", "color":"yellow", "bold": true}, "Use ", {"text": "/trigger enriched.optin", "underlined": true, "click_event": {"action": "suggest_command", "command": "/trigger enriched.optin"}}, " para alternar sua inclusão nas estatísticas."]
execute if score allowSecret enriched.settings matches 1 run tellraw @s ["", {"text": "Modo Secreto\n", "color":"yellow", "bold": true}, "Para esconder nomes ou pontuações de um livro, fique sobre o atril e use ", {"text": "/trigger enriched.secret", "underlined": true, "click_event": {"action": "suggest_command", "command": "/trigger enriched.secret"}}, "."]

scoreboard players set @s enriched.help 0
