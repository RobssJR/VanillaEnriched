tellraw @s ["\n", {"text":"Vanilla Enriched • Help: Statistics Books\n", "color":"gold", "bold": true}, {"text":"How to create a statistics book (Lectern):"}, "\n    1. Choose an objective (e.g. enriched.custom.jump, jump, deaths, etc.).", "\n    2. Write the identifier or shortcut on each page of a Book and Quill.", "\n    3. Sign the book with the title \"EnrichedStats\" (or \"MCStats\").", "\n    4. Place the book on a Lectern to activate it immediately.\n"]

execute if score refreshType enriched.settings matches 1 run tellraw @s ["", {"text": "Book Updates\n", "color":"yellow", "bold": true}, "Stand on top of the lectern and use ", {"text": "/trigger enriched.update", "underlined": true, "click_event": {"action": "suggest_command", "command": "/trigger enriched.update"}}, " to update this book."]
execute if score refreshType enriched.settings matches 2 run tellraw @s ["", {"text": "Book Updates\n", "color":"yellow", "bold": true}, "Stand within 16 blocks of the lectern and use ", {"text": "/trigger enriched.update", "underlined": true, "click_event": {"action": "suggest_command", "command": "/trigger enriched.update"}}, " to update nearby books."]
execute if score refreshType enriched.settings matches 3 run tellraw @s ["", {"text": "Book Updates\n", "color":"yellow", "bold": true}, "All loaded lecterns update every 5 minutes automatically."]
execute if score refreshType enriched.settings matches 4 run tellraw @s ["", {"text": "Book Updates\n", "color":"yellow", "bold": true}, "Books are updated only manually by administrators."]
execute if score autoOptIn enriched.settings matches 0 run tellraw @s ["", {"text": "Participation (Opt-in)\n", "color":"yellow", "bold": true}, "Use ", {"text": "/trigger enriched.optin", "underlined": true, "click_event": {"action": "suggest_command", "command": "/trigger enriched.optin"}}, " to toggle your inclusion in statistics."]
execute if score allowSecret enriched.settings matches 1 run tellraw @s ["", {"text": "Secret Mode\n", "color":"yellow", "bold": true}, "To hide names or scores in a book, stand on the lectern and use ", {"text": "/trigger enriched.secret", "underlined": true, "click_event": {"action": "suggest_command", "command": "/trigger enriched.secret"}}, "."]

scoreboard players set @s enriched.help 0
